<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 每天抓班级作业（tools/hw_schedule.py）。pad 要用数据线插在这台 Mac 上。
     装：cp deploy/com.xiaoxin.homework.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.xiaoxin.homework.plist
     卸：launchctl unload ~/Library/LaunchAgents/com.xiaoxin.homework.plist
     时刻要和 /api/agent 的 at 一致（那边决定「哪一次是最后一次、没抓到要告诉家长」）。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.xiaoxin.homework</string>
  <key>WorkingDirectory</key><string>/Users/cmbian/workspace/codes/ai_xiaoxin</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/cmbian/workspace/codes/ai_xiaoxin/.venv/bin/python</string>
    <string>-u</string>
    <string>-m</string>
    <string>tools.hw_schedule</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/cmbian/Library/Android/sdk/platform-tools:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/cmbian/workspace/codes/ai_xiaoxin/tmp/hw/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/cmbian/workspace/codes/ai_xiaoxin/tmp/hw/launchd.err.log</string>
</dict>
</plist>
