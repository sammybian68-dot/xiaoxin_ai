<?xml version="1.0" encoding="utf-8"?>
<!-- gpu.cmbian.top:8183 是自签证书。只对这个域名信任这一张证书（res/raw/gpu_cert.pem，2027-04-15 到期），
     别的域名照常走系统证书。证书换了要同步换这个文件再重新打包。 -->
<network-security-config>
    <!-- 这份只管原生的连接（自由对话的 wss）。WebView 不看它，WebView 的自签证书在 TalkActivity.onReceivedSslError
         里按同一张证书的指纹放行。 -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- 用 IP 连，不用域名：gpu.cmbian.top 没备案，TLS 里带这个域名的 SNI 会被掐掉。证书 SAN 里有这个 IP。 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">47.116.13.227</domain>
        <trust-anchors>
            <certificates src="@raw/gpu_cert" />
        </trust-anchors>
    </domain-config>
    <!-- 插 USB 调试：adb reverse 把 pad 的 127.0.0.1:18184 接到电脑，电脑再 ssh 转到 gpu2 的 8184。
         只在本机回环上允许明文，数据走 USB 和 ssh，不经过公网。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
